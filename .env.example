# Same project as the mobile app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Supabase dashboard → Project Settings → API → service_role.
# This key bypasses every RLS policy. Server-side only. Never commit it, never
# prefix it NEXT_PUBLIC_, never put it in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Who may sign in here, comma-separated. Anyone not on this list is refused even
# with a correct password. Empty means nobody.
ADMIN_PHONES=0771234567

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
